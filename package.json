{
  "name": "aihubpanel-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "AIHubPanel 桌面版：Electron 壳 + 复用现有 server.mjs",
  "author": "AIHubPanel",
  "main": "electron/main.js",
  "scripts": {
    "check": "node scripts/regression.mjs",
    "test": "npm run check && npm run test:layout && npm run test:perf && npm run test:storage && npm run test:startup",
    "test:layout": "electron scripts/layout-regression.cjs",
    "test:perf": "electron scripts/perf-regression.cjs",
    "test:storage": "electron scripts/storage-regression.cjs",
    "test:startup": "electron scripts/startup-regression.cjs",
    "start": "electron .",
    "dist": "node scripts/clean-release.mjs && electron-builder --win portable && node scripts/clean-release.mjs --keep-portable"
  },
  "devDependencies": {
    "electron": "44.1.1",
    "electron-builder": "26.16.0"
  },
  "build": {
    "appId": "com.aihubpanel.desktop",
    "productName": "AIHubPanel",
    "copyright": "AIHubPanel",
    "directories": {
      "output": "electron/release"
    },
    "files": [
      "package.json",
      "electron/main.js",
      "electron/preload.js",
      "electron/icon.png",
      "server.mjs",
      "public/**/*"
    ],
    "asarUnpack": [
      "server.mjs",
      "public/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "npmRebuild": false,
    "win": {
      "icon": "electron/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "AIHubPanel-${version}.exe"
    }
  }
}
